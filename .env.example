# Bearer token de un usuario registrado en avisos.madrid.es (necesario para crear/listar/consultar).
# Se obtiene del almacenamiento del navegador tras iniciar sesión en https://avisos.madrid.es
MADRID_AVISOS_TOKEN=

# Refresh token (mismo almacenamiento del navegador). Habilita el refresco automático ante 401.
MADRID_AVISOS_REFRESH_TOKEN=

# Ruta opcional a un JSON donde cargar/persistir los tokens (recomendado si hay refresh token,
# porque el refresh token puede rotar en cada refresco).
# MADRID_AVISOS_TOKEN_STORE=./.tokens.json

# Opcionales (tienen valores por defecto extraídos de la app):
# MADRID_AVISOS_BASE_URL=https://servpub.madrid.es/AVSICAPI/
# MADRID_AVISOS_JURISDICTION=es.madrid
# MADRID_AVISOS_LANGUAGE=es
# MADRID_AVISOS_DEVICE_ID=mcp-madrid-avisos
