{
  "name": "madrid-avisos-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP y CLI para la API de Avisos del Ayuntamiento de Madrid (AVSICAPI)",
  "type": "module",
  "bin": {
    "madrid-avisos-mcp": "dist/server.js",
    "madrid-avisos-mcp-http": "dist/http.js",
    "madrid-avisos": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "cli": "node dist/cli.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "exif-parser": "^0.1.12",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
